---
import CrochetItem from "./CrochetItem.astro";

interface Item {
  name: string;
  img: string;
}

interface Props {
  items: Item[];
}

const { items } = Astro.props;
---

<div class="grid">
  {items.map((item) => (
    <CrochetItem name={item.name} img={item.img} />
  ))}
</div>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }

  @media (max-width: 700px) {
    .grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 450px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>