---
interface Props {
  name: string;
  img: string;
  alt?: string;
}

const { name, img, alt = name } = Astro.props;
---

<div class="item">
  <img src={img} alt={alt} />
  <p>{name}</p>
</div>

<style>
  .item {
    text-align: center;
  }

  .item img {
    width: 100%;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    border-radius: 8px;
    display: block;
  }

  .item p {
    margin-top: 0.5rem;
    font-weight: 500;
  }
</style>